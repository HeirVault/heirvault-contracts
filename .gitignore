# Rust / Cargo build output
/target
**/*.rs.bk

# Soroban test snapshots (regenerated by `cargo test`)
test_snapshots/

# Local Stellar CLI state. `stellar keys generate` before CLI v28 wrote keys
# into a project-local `.stellar/` directory; a secret key must never be
# committed. Newer CLI versions use `~/.config/stellar`, but this stays ignored
# so an older toolchain cannot leak a key into the repository.
.stellar/
*.stellar-key
*.secret

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.swp
