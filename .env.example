# ─────────────────────────────────────────────────────────────────────────────
# HeirVault — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`, private keys, secret keys, or seed phrases.
# Every value below is a *public* identifier — nothing here is a secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar network ──────────────────────────────────────────────────────────
# One of: testnet | mainnet | futurenet | standalone
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint used to read contract state and submit transactions.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint (used only for account/balance reads and explorer links).
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase. Leave blank to use the default for the selected
# network; set explicitly for `standalone` / custom networks.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# ── HeirVault Soroban contract ───────────────────────────────────────────────
# Contract ID (C...) of the deployed HeirVault contract.
# Leave blank until a real contract has been deployed to the selected network —
# the UI will surface a "contract not configured" state instead of pretending
# that blockchain calls succeeded.
NEXT_PUBLIC_HEIRVAULT_CONTRACT_ID=

# ── Supported assets ─────────────────────────────────────────────────────────
# Contract ID (C...) of the Stellar Asset Contract (SAC) wrapper for the
# supported asset. On Testnet, USDC is commonly wrapped as a SAC.
NEXT_PUBLIC_USDC_CONTRACT_ID=
# Human-readable symbol / decimals shown in the UI for the asset above.
NEXT_PUBLIC_USDC_SYMBOL=USDC
NEXT_PUBLIC_USDC_DECIMALS=7

# ── Explorer ─────────────────────────────────────────────────────────────────
# Base URL used to build transaction / account / contract explorer links.
NEXT_PUBLIC_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_EXPLORER_TX_PATH=/tx
NEXT_PUBLIC_EXPLORER_ACCOUNT_PATH=/account
NEXT_PUBLIC_EXPLORER_CONTRACT_PATH=/contract

# ── Application behaviour ────────────────────────────────────────────────────
# `true` enables clearly-labelled development fixtures (in-memory/localStorage).
# `false` requires a configured contract for every blockchain action.
NEXT_PUBLIC_ENABLE_DEV_FIXTURES=true
